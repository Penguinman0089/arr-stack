# Copy to .env and fill in. .env is gitignored — this repo is public.

NVR_HOST=
NVR_USER=admin
NVR_PASS=

# *** ALREADY THE RTSP NUMBERS, NOT THE API CHANNELS. ***
# The NVR's API channels are 1, 9, 10, 11 and the RTSP paths are
# Preview_{channel+1:02d}: 02, 10, 11, 12. Single digits ARE zero-padded —
# probing with "1" returns 404 and reads exactly like "this camera has no
# RTSP", which is how that was once concluded and later retracted.
#
# Names are the panel's cam1..cam4. Mapping, from docs/camera-sources.md:
#   cam1 = API channel  9 -> 10
#   cam2 = API channel  1 -> 02
#   cam3 = API channel 11 -> 12
#   cam4 = API channel 10 -> 11
CAMERAS=cam1:10,cam2:02,cam3:12,cam4:11

# Optional shared secret. If set, the panel must request
# /listen/cam1.mp3?t=<token>. Audio from inside the house on an open LAN port
# is worth a token even behind a firewall.
LISTEN_TOKEN=

# 32k mono is ample for a 16 kHz doorbell microphone.
BITRATE=32k
