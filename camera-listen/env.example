# Copy to .env and fill in. .env is gitignored — this repo is public.

# *** go2rtc, NOT THE NVR. *** go2rtc already owns the camera credentials, has
# the streams defined and verified, and can reach the camera VLAN — which this
# host may well not be able to. Asking it removes the password from here, and
# removes any need to know that RTSP paths are Preview_{channel+1:02d} with
# single digits zero-padded (a rule this project has already got wrong once).
SOURCE_BASE=rtsp://<go2rtc-host>:8554

# panel-name:go2rtc-stream-name. Use the SUB streams — same microphone, far
# less video to throw away. The real stream names are in go2rtc.yaml on the
# Home Assistant host; they are camera identities, so they do not live here.
CAMERAS=cam1:<stream>,cam2:<stream>,cam3:<stream>,cam4:<stream>

# Optional shared secret. If set, the panel must request
# /listen/cam1.mp3?t=<token>.
LISTEN_TOKEN=

# 32k mono is ample for a 16 kHz doorbell microphone.
BITRATE=32k

# Seconds to wait for the first audio before giving up on a camera.
CONNECT_TIMEOUT=10
